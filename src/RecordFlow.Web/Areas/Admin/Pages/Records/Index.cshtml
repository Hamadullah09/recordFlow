@page
@model RecordFlow.Web.Areas.Admin.Pages.Records.IndexModel
@{
    ViewData["Title"] = "Finalized records";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
    <h1 class="h4 mb-0">Finalized records</h1>
    <a class="btn btn-outline-primary" asp-page-handler="Export" asp-all-route-data="Model.RouteValues()">Export CSV</a>
</div>
<p class="text-muted mb-3">Confirmed business records. Original CSV files are never stored — only the final, verified values.</p>

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label small" for="q">Search</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Contact ID, store, company, confirmation or order #" /></div>
        <div class="col-6 col-md-2"><label class="form-label small" for="from">Confirmed from</label><input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-6 col-md-2"><label class="form-label small" for="to">to</label><input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3 d-grid"><button class="btn btn-outline-primary" type="submit">Filter</button></div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 data-table responsive-table">
            <thead><tr><th>Confirmed</th><th>Confirmation #</th><th>Contact ID</th><th>Store</th><th>Company</th><th>Confirmed by</th><th>Order #</th><th class="text-end">Amount</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Records)
                {
                    <tr>
                        <td data-label="Confirmed">@Time.DateAndTime(r.ConfirmedAtUtc)</td>
                        <td data-label="Confirmation #" class="font-monospace small">@r.ConfirmationNumber</td>
                        <td data-label="Contact ID">@r.ContactId</td>
                        <td data-label="Store">@(r.StoreName ?? "—")</td>
                        <td data-label="Company">@(r.CompanyName ?? "—")</td>
                        <td data-label="Confirmed by">@r.ConfirmedByName</td>
                        <td data-label="Order #" class="font-monospace small">@r.OrderNumber</td>
                        <td data-label="Amount" class="text-end">@r.Total.ToString("C")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page="./Details" asp-route-id="@r.PublicId">View</a></td>
                    </tr>
                }
                @if (Model.Records.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">No finalized records yet.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>
