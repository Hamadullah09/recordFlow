@page "{slot:int:range(1,6)}"
@model RecordFlow.Web.Areas.Admin.Pages.Columns.EditModel
@{
    ViewData["Title"] = $"Configure column {Model.Slot}";
}
<a class="small text-decoration-none" asp-page="./Index">&larr; All columns</a>
<h1 class="h4 mt-2 mb-3 d-flex align-items-center gap-2"><span class="slot-badge">@Model.Slot</span> Configure column</h1>

<form method="post" class="card border-0 shadow-sm narrow-page" novalidate>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.DisplayLabel" class="form-label"></label>
                <input asp-for="Input.DisplayLabel" class="form-control" />
                <div class="form-text">The column header users see.</div>
                <span asp-validation-for="Input.DisplayLabel" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label">Column name</label>
                <input asp-for="Input.Name" class="form-control font-monospace" />
                <div class="form-text">Internal identifier (e.g. <code>store_region</code>).</div>
                <span asp-validation-for="Input.Name" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.FieldType" class="form-label"></label>
                <select asp-for="Input.FieldType" class="form-select">
                    @foreach (var t in Model.Types) { <option value="@t">@t.Name()</option> }
                </select>
                <span asp-validation-for="Input.FieldType" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.DisplayOrder" class="form-label"></label>
                <input asp-for="Input.DisplayOrder" class="form-control" type="number" min="0" max="999" />
                <span asp-validation-for="Input.DisplayOrder" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.SourceField" class="form-label"></label>
                <input asp-for="Input.SourceField" class="form-control" list="knownFields" placeholder="e.g. Store Name" />
                <datalist id="knownFields">@foreach (var f in Model.KnownFields) { <option value="@f"></option> }</datalist>
                <div class="form-text">Matched against CSV headers and form fields (spacing and capitalization are ignored).</div>
                <span asp-validation-for="Input.SourceField" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.DefaultValue" class="form-label"></label>
                <input asp-for="Input.DefaultValue" class="form-control" />
                <div class="form-text">Used when no other value exists for a record.</div>
                <span asp-validation-for="Input.DefaultValue" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Options" class="form-label"></label>
                <input asp-for="Input.Options" class="form-control" placeholder="Standard, High, Urgent" />
                <div class="form-text">Only for drop-down columns.</div>
                <span asp-validation-for="Input.Options" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12 d-flex flex-wrap gap-4">
                <div class="form-check form-switch"><input class="form-check-input" asp-for="Input.IsActive" role="switch" /><label class="form-check-label" asp-for="Input.IsActive"></label></div>
                <div class="form-check form-switch"><input class="form-check-input" asp-for="Input.IsVisible" role="switch" /><label class="form-check-label" asp-for="Input.IsVisible"></label></div>
                <div class="form-check form-switch"><input class="form-check-input" asp-for="Input.IsRequired" role="switch" /><label class="form-check-label" asp-for="Input.IsRequired"></label></div>
                <div class="form-check form-switch"><input class="form-check-input" asp-for="Input.AllowUserEdit" role="switch" /><label class="form-check-label" asp-for="Input.AllowUserEdit"></label></div>
            </div>
            <span asp-validation-for="Input.IsRequired" class="invalid-feedback d-block"></span>
            <div class="col-12 form-text mt-0">
                Columns are hidden from users when no record in their current CSV has a value. To let users type values into an
                otherwise empty column, turn on both <strong>Users can enter / edit values</strong> and <strong>Required</strong>.
            </div>
        </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-end gap-2">
        <a class="btn btn-light" asp-page="./Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Save column</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
