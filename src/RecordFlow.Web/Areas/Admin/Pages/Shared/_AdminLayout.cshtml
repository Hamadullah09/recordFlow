@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Options.IOptions<RecordFlow.Core.Abstractions.AppOptions> AppOptions
@{
    var path = Context.Request.Path.Value ?? "";
    string Active(string prefix, bool exact = false) =>
        (exact ? string.Equals(path.TrimEnd('/'), prefix, StringComparison.OrdinalIgnoreCase) : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    string? Current(string prefix, bool exact = false) => Active(prefix, exact) == "active" ? "page" : null;
    var displayName = User.GetDisplayName();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Admin · @AppOptions.Value.Name</title>
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body admin-body">
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to main content</a>
    <div class="app-shell">
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="Admin navigation">
            <div class="sidebar-brand">
                <a class="d-flex align-items-center gap-2 text-decoration-none" asp-area="Admin" asp-page="/Index">
                    <partial name="_Logo" />
                    <span><span class="d-block brand-name">@AppOptions.Value.Name</span><span class="admin-badge">Admin</span></span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close menu"></button>
            </div>
            <nav class="sidebar-nav">
                <div class="section-label">Overview</div>
                <a class="nav-link @Active("/Admin", exact: true)" aria-current="@Current("/Admin", exact: true)" asp-area="Admin" asp-page="/Index"><partial name="_Icon" model="@("chart")" /> Dashboard</a>
                <div class="section-label">Calling</div>
                <a class="nav-link @Active("/Admin/Calls")" aria-current="@Current("/Admin/Calls")" asp-area="Admin" asp-page="/Calls/Index"><partial name="_Icon" model="@("list")" /> Call log</a>
                <a class="nav-link @Active("/Admin/Records")" aria-current="@Current("/Admin/Records")" asp-area="Admin" asp-page="/Records/Index"><partial name="_Icon" model="@("check-circle")" /> Completed records</a>
                <a class="nav-link @Active("/Admin/Payments")" aria-current="@Current("/Admin/Payments")" asp-area="Admin" asp-page="/Payments/Index"><partial name="_Icon" model="@("card")" /> Payments &amp; orders</a>
                <div class="section-label">Team</div>
                <a class="nav-link @Active("/Admin/Users")" aria-current="@Current("/Admin/Users")" asp-area="Admin" asp-page="/Users/Index"><partial name="_Icon" model="@("users")" /> Callers &amp; users</a>
                <a class="nav-link @Active("/Admin/Companies")" aria-current="@Current("/Admin/Companies")" asp-area="Admin" asp-page="/Companies/Index"><partial name="_Icon" model="@("building")" /> Companies</a>
                <div class="section-label">Setup</div>
                <a class="nav-link @Active("/Admin/Columns")" aria-current="@Current("/Admin/Columns")" asp-area="Admin" asp-page="/Columns/Index"><partial name="_Icon" model="@("columns")" /> Call desk columns</a>
                <a class="nav-link @Active("/Admin/FormFields")" aria-current="@Current("/Admin/FormFields")" asp-area="Admin" asp-page="/FormFields/Index"><partial name="_Icon" model="@("form")" /> Form fields</a>
                <a class="nav-link @Active("/Admin/Settings")" aria-current="@Current("/Admin/Settings")" asp-area="Admin" asp-page="/Settings/Index"><partial name="_Icon" model="@("sliders")" /> Pricing &amp; settings</a>
                <div class="section-label">System</div>
                <a class="nav-link @Active("/Admin/AuditLogs")" aria-current="@Current("/Admin/AuditLogs")" asp-area="Admin" asp-page="/AuditLogs/Index"><partial name="_Icon" model="@("activity")" /> Audit log</a>
            </nav>
            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <span class="avatar" aria-hidden="true">@(displayName.FirstOrDefault())</span>
                    <span class="min-w-0">
                        <span class="d-block text-truncate fw-semibold text-white">@displayName</span>
                        <span class="d-block text-truncate small">@User.Identity!.Name</span>
                    </span>
                </div>
                <form method="post" asp-area="" asp-page="/Account/Logout" class="m-0">
                    <button type="submit" class="btn btn-sm btn-sidebar" title="Sign out" aria-label="Sign out"><partial name="_Icon" model="@("logout")" /></button>
                </form>
            </div>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu">
                    <partial name="_Icon" model="@("menu")" />
                </button>
                <span class="topbar-title text-truncate">@ViewData["Title"]</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="topbar-clock d-none d-md-inline" title="Portal time zone">@Time.Abbreviation</span>
                    <a class="btn btn-sm btn-call" asp-area="" asp-page="/Dashboard"><partial name="_Icon" model="@("headset")" /> <span class="d-none d-sm-inline">Call desk</span></a>
                </div>
            </header>
            <main id="main" class="app-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastHost" aria-live="polite" aria-atomic="true"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
