{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "Name": "RecordFlow",
    "PublicBaseUrl": "",
    "TimeZone": "America/New_York",
    "SupportEmail": "support@example.com"
  },
  "Identity": {
    "RequireConfirmedEmail": true,
    "SessionTimeoutMinutes": 60
  },
  "Workspace": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "IdleTimeoutMinutes": 120,
    "MaxLifetimeHours": 24
  },
  "CsvImport": {
    "MaxFileBytes": 5242880,
    "MaxRows": 5000,
    "MaxColumns": 100,
    "MaxValueLength": 2000
  },
  "Payments": {
    "Provider": "Stripe",
    "EnableAch": false,
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@example.com",
    "FromName": "RecordFlow",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": ""
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AdminPortal": {
    "AllowedIps": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Seed": {
    "AdminUserId": "",
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Portal Administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
