@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="empty-state text-center mx-auto py-5">
    <h1 class="h3 mb-3">Something went wrong</h1>
    <p class="text-muted mb-4">We couldn't complete your request. Please try again. If the problem continues, contact support and mention the reference below.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">Go to the home page</a>
</div>
