@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Options.IOptions<RecordFlow.Core.Abstractions.AppOptions> AppOptions
@{
    var appName = AppOptions.Value.Name;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = signedIn && User.IsInRole(Roles.Administrator);
    var path = Context.Request.Path.Value ?? "";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · {appName}" : appName)</title>
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to main content</a>
    <header class="app-header border-bottom bg-white sticky-top">
        <nav class="navbar navbar-expand-lg container-xl" aria-label="Main navigation">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-page="@(signedIn ? "/Dashboard" : "/Index")">
                <partial name="_Logo" />
                <span class="fw-bold">@appName</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (signedIn)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Active("/dashboard") @Active("/records")" asp-page="/Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/receipts")" asp-page="/Receipts/Index">Orders &amp; Receipts</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-page="/Index">Admin Portal</a></li>
                        }
                    </ul>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar" aria-hidden="true">@(User.GetDisplayName().FirstOrDefault())</span>
                            <span class="text-truncate user-name">@User.GetDisplayName()</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><span class="dropdown-item-text small text-muted">Signed in as @User.Identity!.Name</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-page="/Account/Manage/Index">Profile</a></li>
                            <li><a class="dropdown-item" asp-page="/Account/Manage/ChangePassword">Change password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="dropdown-item">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="ms-auto d-flex gap-2 py-2 py-lg-0">
                        <a class="btn btn-outline-primary" asp-page="/Account/Login">Sign in</a>
                        <a class="btn btn-primary" asp-page="/Account/Register">Create account</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main id="main" class="flex-grow-1 py-4 py-lg-5">
        <div class="container-xl">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer border-top bg-white py-4 mt-auto">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between gap-2 small text-muted">
            <span>&copy; @DateTime.UtcNow.Year @appName. All rights reserved.</span>
            <nav class="d-flex gap-3" aria-label="Footer">
                <a asp-page="/Privacy">Privacy</a>
                <a asp-page="/Terms">Terms</a>
                <a href="mailto:@AppOptions.Value.SupportEmail">Support</a>
            </nav>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastHost" aria-live="polite" aria-atomic="true"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
