@inject Microsoft.Extensions.Options.IOptions<RecordFlow.Core.Abstractions.AppOptions> AppOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] ?? "Secure form") · @AppOptions.Value.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 recipient">
    <header class="app-header border-bottom bg-white">
        <div class="container-lg py-3 d-flex align-items-center justify-content-between">
            <span class="d-flex align-items-center gap-2 fw-bold"><partial name="_Logo" /> @AppOptions.Value.Name</span>
            <span class="badge rounded-pill text-bg-light border secure-badge"><span aria-hidden="true">&#128274;</span> Secure form</span>
        </div>
    </header>
    <main id="main" class="flex-grow-1 py-4 py-lg-5">
        <div class="container-lg">
            @RenderBody()
        </div>
    </main>
    <footer class="border-top bg-white py-3 small text-muted">
        <div class="container-lg">This page was shared with you through a private link. Please do not forward it.</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
