@page
@model ResendConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation email";
}
<h1 class="h3 mb-1">Resend confirmation email</h1>
<p class="text-muted mb-4">Enter the email address you registered with and we'll send a new link.</p>
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Send link</button>
    <a class="btn btn-link w-100 mt-2" asp-page="./Login">Back to sign in</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
