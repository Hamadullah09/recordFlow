@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1 class="h3 mb-1">Forgot your password?</h1>
<p class="text-muted mb-4">Enter your User ID or email address and we'll email you a link to reset it.</p>
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Login" class="form-label"></label>
        <input asp-for="Login" class="form-control form-control-lg" autocomplete="username" autofocus />
        <span asp-validation-for="Login" class="invalid-feedback d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Email me a reset link</button>
    <a class="btn btn-link w-100 mt-2" asp-page="./Login">Back to sign in</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
