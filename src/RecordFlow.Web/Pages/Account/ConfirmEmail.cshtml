@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}
<div class="text-center">
    @if (Model.Succeeded)
    {
        <div class="icon-circle icon-success mx-auto mb-3" aria-hidden="true">&#10003;</div>
        <h1 class="h3 mb-3">Email confirmed</h1>
        <p class="text-muted">Thank you. Your account is active and you can sign in now.</p>
        <a class="btn btn-primary btn-lg mt-2" asp-page="./Login">Sign in</a>
    }
    else
    {
        <div class="icon-circle icon-danger mx-auto mb-3" aria-hidden="true">!</div>
        <h1 class="h3 mb-3">This link is invalid or has expired</h1>
        <p class="text-muted">Confirmation links can be used once and expire after 3 hours.</p>
        <a class="btn btn-primary mt-2" asp-page="./ResendConfirmation">Send a new link</a>
    }
</div>
