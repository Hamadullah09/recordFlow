@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<h1 class="h3 mb-1">Choose a new password</h1>
<p class="text-muted mb-4">Use at least 10 characters with upper- and lowercase letters, a number and a symbol.</p>
<form method="post" novalidate>
    <input type="hidden" asp-for="Uid" />
    <input type="hidden" asp-for="Code" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" data-password-strength="#pwStrength" autofocus />
        <div class="password-meter mt-2" id="pwStrength" aria-live="polite">
            <div class="progress" role="presentation"><div class="progress-bar"></div></div>
            <small class="text-muted meter-label"></small>
        </div>
        <span asp-validation-for="Input.Password" class="invalid-feedback d-block"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Save password</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
