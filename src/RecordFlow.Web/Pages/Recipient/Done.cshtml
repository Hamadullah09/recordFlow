@page "/form-submitted"
@{
    ViewData["Title"] = "Thank you";
}
<div class="narrow-page narrow-page-sm mx-auto">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">
            <div class="icon-circle icon-success icon-lg mx-auto mb-3" aria-hidden="true">&#10003;</div>
            <h1 class="h3 mb-2">Thank you!</h1>
            <p class="text-muted mb-0">Your information was submitted securely. The requester has been notified and will review it. You can close this page.</p>
        </div>
    </div>
</div>
