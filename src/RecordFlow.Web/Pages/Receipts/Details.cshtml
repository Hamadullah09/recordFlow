@page "/receipts/{id:guid}"
@model RecordFlow.Web.Pages.Receipts.DetailsModel
@{
    var o = Model.Order;
    var f = Model.Finalized;
    ViewData["Title"] = f is not null ? "Confirmation & receipt" : "Receipt";
}
<div class="narrow-page mx-auto receipt">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <a class="small text-decoration-none" asp-page="/Receipts/Index">&larr; All orders</a>
        <button type="button" class="btn btn-outline-secondary js-print">Print / save as PDF</button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                @if (f is not null)
                {
                    <div class="icon-circle icon-success icon-lg mx-auto mb-3" aria-hidden="true">&#10003;</div>
                    <h1 class="h3 mb-1">Confirmed — payment successful</h1>
                    <p class="text-muted mb-0">Thank you. This record has been verified and closed.</p>
                }
                else if (o.IsPaid)
                {
                    <div class="icon-circle icon-success icon-lg mx-auto mb-3" aria-hidden="true">&#10003;</div>
                    <h1 class="h3 mb-1">Payment successful</h1>
                    <p class="text-muted mb-0">The record for this order has not been confirmed yet.</p>
                }
                else
                {
                    <h1 class="h3 mb-1">Order @o.OrderNumber</h1>
                    <p class="text-muted mb-0">Payment status: @o.Status.Name()</p>
                }
            </div>

            <div class="row g-3 text-center mb-4 receipt-highlights">
                @if (f is not null)
                {
                    <div class="col-sm-6"><div class="highlight"><div class="small text-muted">Confirmation number</div><div class="fs-5 fw-bold font-monospace">@f.ConfirmationNumber</div></div></div>
                }
                <div class="@(f is null ? "col-12" : "col-sm-6")"><div class="highlight"><div class="small text-muted">Order / reference number</div><div class="fs-5 fw-bold font-monospace">@o.OrderNumber</div></div></div>
            </div>

            <h2 class="h6 text-uppercase text-muted">Payment</h2>
            <dl class="row small kv mb-4">
                <dt class="col-sm-5">Payment status</dt><dd class="col-sm-7"><span class="badge rounded-pill @(o.IsPaid ? "text-bg-success" : "text-bg-warning")">@o.Status.Name()</span></dd>
                <dt class="col-sm-5">Service</dt><dd class="col-sm-7">@o.ServiceName</dd>
                <dt class="col-sm-5">Subtotal</dt><dd class="col-sm-7">@o.Subtotal.ToString("C")</dd>
                @if (o.Tax > 0) { <dt class="col-sm-5">Sales tax</dt><dd class="col-sm-7">@o.Tax.ToString("C")</dd> }
                @if (o.Fee > 0) { <dt class="col-sm-5">Processing fee</dt><dd class="col-sm-7">@o.Fee.ToString("C")</dd> }
                <dt class="col-sm-5">Total paid</dt><dd class="col-sm-7 fw-bold">@o.Total.ToString("C") USD</dd>
                <dt class="col-sm-5">Payment date</dt><dd class="col-sm-7">@Time.DateAndTime(o.PaidAtUtc)</dd>
                <dt class="col-sm-5">Payment method</dt>
                <dd class="col-sm-7 text-capitalize">@(o.CardBrand is null ? o.PaymentMethod.Name() : $"{o.CardBrand} •••• {o.CardLast4}")</dd>
                <dt class="col-sm-5">Transaction ID</dt><dd class="col-sm-7 font-monospace text-break">@(o.ProviderPaymentId ?? "—")</dd>
                <dt class="col-sm-5">Billed to</dt>
                <dd class="col-sm-7">@o.BillingName<br />@o.BillingAddressLine1@if (!string.IsNullOrEmpty(o.BillingAddressLine2)) {<br />@o.BillingAddressLine2}<br />@o.BillingCityStateZip<br />@o.BillingEmail</dd>
            </dl>

            <h2 class="h6 text-uppercase text-muted">Record</h2>
            <dl class="row small kv mb-4">
                <dt class="col-sm-5">Contact ID</dt><dd class="col-sm-7">@o.ContactId</dd>
                <dt class="col-sm-5">Store</dt><dd class="col-sm-7">@(f?.StoreName ?? o.StoreName ?? "—")</dd>
                @if (f is not null)
                {
                    <dt class="col-sm-5">Response</dt><dd class="col-sm-7">@(f.Response switch { "Y" => "Yes", "N" => "No", _ => "—" })</dd>
                    @foreach (var c in Model.Columns)
                    {
                        <dt class="col-sm-5">@c.Label</dt><dd class="col-sm-7">@(c.Value ?? "—")</dd>
                    }
                    <dt class="col-sm-5">Recipient submitted</dt><dd class="col-sm-7">@Time.DateAndTime(f.RecipientSubmittedAtUtc)</dd>
                    <dt class="col-sm-5">Confirmed by</dt><dd class="col-sm-7">@f.ConfirmedByName</dd>
                    <dt class="col-sm-5">Confirmed at</dt><dd class="col-sm-7">@Time.DateAndTime(f.ConfirmedAtUtc)</dd>
                }
            </dl>

            @if (f is not null)
            {
                <details class="final-fields">
                    <summary class="fw-semibold mb-2">Verified information</summary>
                    @foreach (var grp in Model.Sections)
                    {
                        <h3 class="h6 mt-3">@grp.Key</h3>
                        <dl class="row small kv mb-0">
                            @foreach (var field in grp)
                            {
                                <dt class="col-sm-5">@field.Label</dt><dd class="col-sm-7">@(string.IsNullOrWhiteSpace(field.Value) ? "—" : field.Value)</dd>
                            }
                        </dl>
                    }
                </details>
            }
            else if (o.IsPaid)
            {
                <div class="alert alert-info small mb-0">
                    To finish this record, open it from your <a asp-page="/Dashboard">dashboard</a>. If your working session has ended,
                    upload the same CSV again — the record with Contact ID <strong>@o.ContactId</strong> is matched to this paid order automatically, so you won't be charged twice.
                </div>
            }
        </div>
    </div>
</div>
