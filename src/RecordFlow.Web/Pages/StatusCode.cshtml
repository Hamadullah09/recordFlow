@page
@model StatusCodeModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="empty-state text-center mx-auto py-5">
    <p class="display-6 fw-bold text-primary mb-2">@Model.Code</p>
    <h1 class="h3 mb-3">@Model.Title</h1>
    <p class="text-muted mb-4">@Model.Message</p>
    <a class="btn btn-primary" href="/">Go to the home page</a>
</div>
