@page "/records/{key}/form"
@model RecordFlow.Web.Pages.Records.FormModel
@{
    ViewData["Title"] = "Form";
    var r = Model.Record;
    var share = r.Share;
    var missingRequired = r.MissingRequiredCount;
    var missing = r.MissingCount;
    var store = r.StoreName ?? $"Contact ID {r.ContactId}";
    var api = Url.Content($"~/api/workspace/records/{Uri.EscapeDataString(r.Key)}");
}
<partial name="_RecordStepper" model="new StepperModel(r, 4)" />

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a class="small text-decoration-none" asp-page="/Dashboard">&larr; Back to dashboard</a>
        <h1 class="h3 mt-2 mb-1">@store</h1>
        <p class="text-muted mb-0">Contact ID @r.ContactId · Order @r.OrderNumber</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-lg px-4" data-bs-toggle="modal" data-bs-target="#shareModal">
            <span aria-hidden="true">&#10148;</span> Share form
        </button>
        <a class="btn btn-outline-primary btn-lg" asp-page="/Records/Verify" asp-route-key="@r.Key">Verify details</a>
    </div>
</div>

<div id="recipientBanner" class="@(r.Status == RecordStatus.ReadyForVerification ? "" : "d-none")">
    <div class="alert alert-success d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1">
            <strong>The recipient submitted the form</strong>@(r.RecipientSubmittedAtUtc is null ? "" : $" on {Time.DateAndTime(r.RecipientSubmittedAtUtc)}"). Your record was updated automatically.
        </div>
        <a class="btn btn-success" asp-page="/Records/Verify" asp-route-key="@r.Key">Review &amp; verify</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap gap-4 align-items-center">
                <div>
                    <div class="small text-muted">Status</div>
                    <span class="badge rounded-pill @DashboardModel.StatusBadgeClass(r.Status)" id="statusBadge" data-status-endpoint="@api/status" data-current-status="@r.Status">@r.Status.Name()</span>
                </div>
                <div>
                    <div class="small text-muted">Information still needed</div>
                    <div class="fw-semibold">@missing field@(missing == 1 ? "" : "s") <span class="text-muted fw-normal">(@missingRequired required)</span></div>
                </div>
                <div class="ms-auto small text-muted legend d-flex flex-wrap gap-2">
                    <span class="badge rounded-pill badge-csv">From CSV</span>
                    <span class="badge rounded-pill badge-user">Updated by you</span>
                    <span class="badge rounded-pill badge-recipient">Added by recipient</span>
                    <span class="badge rounded-pill badge-missing">Needs info</span>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="Save" novalidate id="recordForm">
            @foreach (var grp in Model.Sections)
            {
                <section class="card border-0 shadow-sm mb-3 form-section">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">@grp.Key.Name()</h2></div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var f in grp)
                            {
                                <div class="@(f.FieldType == FieldType.TextArea ? "col-12" : "col-md-6")">
                                    <partial name="_FieldInput" model="new FieldInputModel(f, Model.ValueFor(f), Model.Errors.GetValueOrDefault(f.Key), ReadOnly: false)" />
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }

            <div class="sticky-actions card border-0 shadow-sm">
                <div class="card-body d-flex flex-wrap gap-2 justify-content-end">
                    <button type="submit" class="btn btn-outline-primary btn-lg">Save changes</button>
                    <button type="submit" name="next" value="verify" class="btn btn-primary btn-lg">Save &amp; verify</button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        @if (Model.Order is not null)
        {
            <partial name="_OrderReadOnly" model="Model.Order" />
        }
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Sharing</h2></div>
            <div class="card-body small">
                @if (share is null)
                {
                    <p class="text-muted mb-2">Not shared yet. Use <strong>Share form</strong> to send a secure link to the store owner or manager so they can fill in what's missing.</p>
                }
                else
                {
                    <dl class="row mb-0 kv">
                        <dt class="col-5">Link created</dt><dd class="col-7">@Time.DateAndTime(share.CreatedAtUtc)</dd>
                        <dt class="col-5">Last opened</dt><dd class="col-7">@(share.LastOpenedAtUtc is null ? "Not yet" : Time.DateAndTime(share.LastOpenedAtUtc))</dd>
                        <dt class="col-5">Submitted</dt><dd class="col-7">@(share.SubmittedAtUtc is null ? "Not yet" : Time.DateAndTime(share.SubmittedAtUtc))</dd>
                        <dt class="col-5">Expires</dt><dd class="col-7">@Time.DateAndTime(share.ExpiresAtUtc)</dd>
                    </dl>
                    @if (share.SentTo.Count > 0)
                    {
                        <div class="mt-2 text-muted">Sent via:</div>
                        <ul class="ps-3 mb-0 text-muted">
                            @foreach (var s in share.SentTo.TakeLast(5)) { <li>@s.Split(" · ")[0]</li> }
                        </ul>
                    }
                }
                <p class="text-muted mt-3 mb-0">The recipient can add or correct information but can't change payment or billing details.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalTitle" aria-hidden="true"
     data-endpoint="@api" data-store="@store">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h5" id="shareModalTitle">Share form</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="share-loading text-center py-4 text-muted">Creating a secure link…</div>
                <div class="share-error alert alert-danger d-none" role="alert"></div>
                <div class="share-ready d-none">
                    <div class="share-submitted alert alert-success small d-none">
                        The recipient already submitted this form. Create a new link if you need them to make more changes.
                    </div>
                    <label class="form-label" for="shareLink">Secure link</label>
                    <div class="input-group mb-1">
                        <input id="shareLink" class="form-control" readonly />
                        <button class="btn btn-outline-primary js-copy-link" type="button">Copy</button>
                    </div>
                    <p class="small text-muted share-expiry mb-3"></p>

                    <div class="share-grid mb-3">
                        <button type="button" class="share-btn js-share-email-toggle"><span aria-hidden="true">&#9993;</span>Email</button>
                        <a class="share-btn js-share-whatsapp" target="_blank" rel="noopener noreferrer" href="#"><span aria-hidden="true">&#128172;</span>WhatsApp</a>
                        <a class="share-btn js-share-sms" href="#"><span aria-hidden="true">&#128241;</span>Text (SMS)</a>
                        <button type="button" class="share-btn js-share-native d-none"><span aria-hidden="true">&#8599;</span>More…</button>
                    </div>

                    <form class="share-email-form d-none border rounded p-3 mb-3" novalidate>
                        <div class="mb-2">
                            <label class="form-label small" for="shareEmailTo">Recipient email</label>
                            <input type="email" class="form-control" id="shareEmailTo" maxlength="254" required autocomplete="off" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="shareEmailNote">Message (optional)</label>
                            <textarea class="form-control" id="shareEmailNote" rows="2" maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send email</button>
                    </form>

                    <div class="d-flex justify-content-between align-items-center small">
                        <span class="text-muted">Anyone with this link can view and complete this form.</span>
                        <button type="button" class="btn btn-link btn-sm js-regenerate">New link</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
