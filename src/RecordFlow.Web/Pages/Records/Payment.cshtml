@page "/records/{key}/payment"
@model RecordFlow.Web.Pages.Records.PaymentModel
@{
    var order = Model.Order!;
    var processing = order.Status == OrderStatus.Processing;
    ViewData["Title"] = "Payment status";
}
<partial name="_RecordStepper" model="new StepperModel(Model.Record, 4)" />

<div class="narrow-page mx-auto">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="icon-circle icon-primary icon-lg mx-auto mb-3" aria-hidden="true">&#8987;</div>
            @if (processing)
            {
                <h1 class="h3 mb-2">Payment processing</h1>
                <p class="text-muted mb-4">Bank payments usually take 3–5 business days to clear. The record is completed automatically once the payment is confirmed.</p>
            }
            else
            {
                <h1 class="h3 mb-2">Waiting for payment</h1>
                <p class="text-muted mb-4">The record is confirmed and locked. We haven't received the payment yet — if the payment page was closed, open it again below.</p>
            }

            <dl class="row text-start small receipt-grid mx-auto mb-4">
                <dt class="col-6">Order number</dt><dd class="col-6 font-monospace">@order.OrderNumber</dd>
                <dt class="col-6">Contact ID</dt><dd class="col-6">@order.ContactId</dd>
                <dt class="col-6">Billing name</dt><dd class="col-6">@order.BillingName</dd>
                <dt class="col-6">Amount</dt><dd class="col-6">@order.Total.ToString("C")</dd>
                <dt class="col-6">Status</dt><dd class="col-6">@order.Status.Name()</dd>
            </dl>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="btn btn-outline-primary btn-lg" asp-page="/Records/Payment" asp-route-key="@Model.Key">Refresh status</a>
                @if (!processing)
                {
                    <form method="post" asp-page-handler="Retry">
                        <button type="submit" class="btn btn-primary btn-lg">Open payment page</button>
                    </form>
                    <form method="post" asp-page-handler="Cancel" data-confirm="Cancel this payment and unlock the record for editing?">
                        <button type="submit" class="btn btn-link btn-lg">Cancel &amp; edit</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
