{
  "//": "Example only. Put secrets in environment variables or Azure Key Vault, never in source control. Environment variable form: ConnectionStrings__DefaultConnection, Payments__Stripe__SecretKey, etc.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<server>.database.windows.net,1433;Database=RecordFlow;Authentication=Active Directory Default;Encrypt=True;"
  },
  "App": {
    "Name": "RecordFlow",
    "PublicBaseUrl": "https://portal.example.com",
    "TimeZone": "America/New_York",
    "SupportEmail": "support@example.com"
  },
  "Identity": {
    "RequireConfirmedEmail": true,
    "SessionTimeoutMinutes": 60
  },
  "Workspace": {
    "Provider": "Redis",
    "RedisConnectionString": "<name>.redis.cache.windows.net:6380,password=<from-key-vault>,ssl=True,abortConnect=False",
    "IdleTimeoutMinutes": 120,
    "MaxLifetimeHours": 24
  },
  "Payments": {
    "Provider": "Stripe",
    "EnableAch": false,
    "Stripe": {
      "SecretKey": "<sk_live_... from Key Vault>",
      "WebhookSecret": "<whsec_... from Key Vault>"
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@example.com",
    "FromName": "RecordFlow",
    "Smtp": {
      "Host": "smtp.sendgrid.net",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "apikey",
      "Password": "<from Key Vault>"
    }
  },
  "DataProtection": {
    "CertificatePath": "/var/ssl/private/dataprotection.pfx",
    "CertificatePassword": "<from Key Vault>"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AdminPortal": {
    "AllowedIps": [ "203.0.113.10" ]
  },
  "ReverseProxy": {
    "KnownProxies": [ "10.0.0.4" ]
  },
  "Seed": {
    "AdminUserId": "admin",
    "AdminEmail": "it-admin@example.com",
    "AdminPassword": "<one-time bootstrap password – remove after first sign-in>"
  },
  "AllowedHosts": "portal.example.com"
}
